<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- State when the switch is ON (checked) -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <!-- A light blue color for the track when 'on', matching the app theme -->
            <solid android:color="@color/primaryLight" />
            <!-- Fully rounded corners to create a pill shape -->
            <corners android:radius="100dp" />
        </shape>
    </item>

    <!-- State when the switch is OFF (unchecked) -->
    <item>
        <shape android:shape="rectangle">
            <!-- The light grey color seen in the 'off' state in your image -->
            <solid android:color="#ECECEC" />
            <corners android:radius="100dp" />
        </shape>
    </item>

</selector>

