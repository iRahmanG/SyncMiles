<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp">

    <!-- Icon with background -->
    <ImageView
        android:id="@+id/ivWalkIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/history_icon_background"
        android:padding="14dp"
        android:src="@drawable/ic_walking_shoes"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Text content container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivWalkIcon"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvWalkDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            tools:text="Today, 10:00 AM" />

        <TextView
            android:id="@+id/tvWalkFeeling"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/history_feeling_text"
            tools:text="Feeling: Energetic" />

        <TextView
            android:id="@+id/tvWalkStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@android:color/darker_gray"
            tools:text="1.2 mi · 25 min · 12:30 min/mi · 150 cal" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
